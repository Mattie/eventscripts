function(eventscripts_stage_sdk_utlbuffer input output)
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Missing explicitly required SDK source: ${input}")
  endif()
  file(SHA256 "${input}" fingerprint)
  set(final "3b481a02ab1fab3c6f681aee4a7321297822785d5ac5fd855eae4cfed689e461")
  set(baseline "c95119c5639fdcea32ee38ad02f6aff76d1d0d35d7e1084e72f617a37d36b60d")
  if(fingerprint STREQUAL final)
    get_filename_component(output_directory "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    configure_file("${input}" "${output}" COPYONLY)
  elseif(fingerprint STREQUAL baseline)
    file(READ "${input}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    set(old "\tchar c = GetChar();\n\t\n\t// End of buffer")
    set(fixed "\tunsigned char c = GetChar();\n\t\n\t// End of buffer")
    string(REPLACE "${old}" "${fixed}" source "${source}")
    string(SHA256 patched_fingerprint "${source}")
    if(NOT patched_fingerprint STREQUAL "4e2c1d51f09004abc909d1fc257156aec5c554d3613a399884519e6d054b9d36")
      message(FATAL_ERROR "The guarded SDK token-character patch did not reproduce the verified final source; refusing to stage it.")
    endif()
    get_filename_component(output_directory "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    file(WRITE "${output}" "${source}")
    file(SHA256 "${output}" output_fingerprint)
    if(NOT output_fingerprint STREQUAL final)
      file(REMOVE "${output}")
      message(FATAL_ERROR "Staged SDK source bytes differ from the verified final source; refusing an unverified SDK rewrite.")
    endif()
    message(STATUS "Staging the verified unsigned-character SDK token parsing correction")
  else()
    message(FATAL_ERROR "Unknown SDK utlbuffer.cpp hash; supply the verified final source or its exact unpatched baseline. Refusing an unverified SDK rewrite.")
  endif()
endfunction()
